{
  "name": "autocomplete-snippets",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Adds snippets to autocomplete suggestions.",
  "keywords": [
    "template",
    "expansion",
    "completion",
    "suggestion",
    "tab-stop"
  ],
  "repository": "https://github.com/lumine-code/autocomplete-snippets",
  "bugs": {
    "url": "https://github.com/lumine-code/autocomplete-snippets/issues"
  },
  "license": "MIT",
  "main": "./lib/autocomplete-snippets",
  "files": [
    "lib",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "specPackages": [
    "autocomplete",
    "language-javascript",
    "snippets"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "autocomplete.provider": {
      "versions": {
        "1.0.0": "provideAutocomplete"
      }
    }
  },
  "consumedServices": {
    "snippets": {
      "versions": {
        "^1.0.0": "consumeSnippets"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
